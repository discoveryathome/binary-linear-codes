{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Binary generator certificate v1",
 "type":"object",
 "required":["format","q","n","k","d","rows","provenance"],
 "properties":{
  "format":{"const":"binary-generator-v1"},"q":{"const":2},
  "n":{"type":"integer","minimum":1,"maximum":512},
  "k":{"type":"integer","minimum":1,"maximum":20},
  "d":{"type":"integer","minimum":1,"maximum":512},
  "rows":{"type":"array","minItems":1,"maxItems":20,"items":{"type":"string","pattern":"^[01]+$"}},
  "provenance":{"type":"object"}
 },
 "description":"Cross-field shape, full rank and exact distance are enforced by the two executable verifiers; schema validation alone is insufficient."
}
